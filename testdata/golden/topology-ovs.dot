digraph netdoctor {
  label="VirtualMachine demo/db-03 (solid: observed, dashed: declared, dotted: inferred)";
  labelloc=t;
  rankdir=LR;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  "Bond/bond1" [label="Bond\nbond1", shape=doubleoctagon];
  "BondMember/bond1/ens1f0" [label="BondMember\nbond1/ens1f0", shape=ellipse];
  "BondMember/bond1/ens1f1" [label="BondMember\nbond1/ens1f1", shape=ellipse];
  "ClusterNetwork/k8s-pod-network" [label="ClusterNetwork\nk8s-pod-network", shape=cylinder];
  "GuestInterface/demo/db-03/data" [label="GuestInterface\ndemo/db-03/data", shape=ellipse];
  "GuestInterface/demo/db-03/default" [label="GuestInterface\ndemo/db-03/default", shape=ellipse];
  "HostInterface/bond1" [label="HostInterface\nbond1", shape=ellipse];
  "LauncherPod/demo/virt-launcher-db-03-p8w4k" [label="LauncherPod\ndemo/virt-launcher-db-03-p8w4k", shape=box];
  "NetworkAttachmentDefinition/demo/ovs-vlan200" [label="NetworkAttachmentDefinition\ndemo/ovs-vlan200", shape=note];
  "Node/worker-2" [label="Node\nworker-2", shape=box];
  "OVSBridge/br-data" [label="OVSBridge\nbr-data", shape=hexagon];
  "OVSPort/veth3e9a1c7b" [label="OVSPort\nveth3e9a1c7b", shape=ellipse];
  "PodInterface/demo/virt-launcher-db-03-p8w4k/eth0" [label="PodInterface\ndemo/virt-launcher-db-03-p8w4k/eth0", shape=ellipse];
  "PodInterface/demo/virt-launcher-db-03-p8w4k/pod3e9a1c7b2d0" [label="PodInterface\ndemo/virt-launcher-db-03-p8w4k/pod3e9a1c7b2d0", shape=ellipse];
  "VMINetwork/demo/db-03/data" [label="VMINetwork\ndemo/db-03/data", shape=ellipse];
  "VMINetwork/demo/db-03/default" [label="VMINetwork\ndemo/db-03/default", shape=ellipse];
  "VirtualMachine/demo/db-03" [label="VirtualMachine\ndemo/db-03", shape=box3d];
  "VirtualMachineInstance/demo/db-03" [label="VirtualMachineInstance\ndemo/db-03", shape=box3d];
  "VirtualMachine/demo/db-03" -> "VirtualMachineInstance/demo/db-03" [label="runs (Observed)", style=solid, tooltip="VMI owned by the VM"];
  "VirtualMachineInstance/demo/db-03" -> "Node/worker-2" [label="scheduled-on (Observed)", style=solid, tooltip="VMI status.nodeName"];
  "VirtualMachineInstance/demo/db-03" -> "LauncherPod/demo/virt-launcher-db-03-p8w4k" [label="hosted-by (Observed)", style=solid, tooltip="single active virt-launcher pod owned by the VMI"];
  "LauncherPod/demo/virt-launcher-db-03-p8w4k" -> "Node/worker-2" [label="scheduled-on (Observed)", style=solid, tooltip="pod spec.nodeName"];
  "VirtualMachineInstance/demo/db-03" -> "VMINetwork/demo/db-03/default" [label="declares (Declared)", style=dashed, tooltip="VMI spec.networks / spec.domain.devices.interfaces"];
  "VMINetwork/demo/db-03/default" -> "GuestInterface/demo/db-03/default" [label="realized-as (Observed)", style=solid, tooltip="VMI status.interfaces"];
  "LauncherPod/demo/virt-launcher-db-03-p8w4k" -> "PodInterface/demo/virt-launcher-db-03-p8w4k/eth0" [label="has-interface (Observed)", style=solid, tooltip="Multus network-status"];
  "VMINetwork/demo/db-03/default" -> "PodInterface/demo/virt-launcher-db-03-p8w4k/eth0" [label="attached-via (Observed)", style=solid, tooltip="matched by defaultFlag"];
  "GuestInterface/demo/db-03/default" -> "PodInterface/demo/virt-launcher-db-03-p8w4k/eth0" [label="bound-to (Inferred)", style=dotted, tooltip="masquerade binding: guest traffic is NATed to the pod interface address"];
  "PodInterface/demo/virt-launcher-db-03-p8w4k/eth0" -> "ClusterNetwork/k8s-pod-network" [label="member-of (Declared)", style=dashed, tooltip="pod network (primary CNI)"];
  "VirtualMachineInstance/demo/db-03" -> "VMINetwork/demo/db-03/data" [label="declares (Declared)", style=dashed, tooltip="VMI spec.networks / spec.domain.devices.interfaces"];
  "VMINetwork/demo/db-03/data" -> "GuestInterface/demo/db-03/data" [label="realized-as (Observed)", style=solid, tooltip="VMI status.interfaces"];
  "LauncherPod/demo/virt-launcher-db-03-p8w4k" -> "PodInterface/demo/virt-launcher-db-03-p8w4k/pod3e9a1c7b2d0" [label="has-interface (Observed)", style=solid, tooltip="Multus network-status"];
  "VMINetwork/demo/db-03/data" -> "PodInterface/demo/virt-launcher-db-03-p8w4k/pod3e9a1c7b2d0" [label="attached-via (Observed)", style=solid, tooltip="matched by podInterfaceName"];
  "GuestInterface/demo/db-03/data" -> "PodInterface/demo/virt-launcher-db-03-p8w4k/pod3e9a1c7b2d0" [label="bound-to (Inferred)", style=dotted, tooltip="bridge binding: the pod interface is bridged to the guest at layer 2"];
  "VMINetwork/demo/db-03/data" -> "NetworkAttachmentDefinition/demo/ovs-vlan200" [label="references (Declared)", style=dashed, tooltip="spec.networks[].multus.networkName"];
  "PodInterface/demo/virt-launcher-db-03-p8w4k/pod3e9a1c7b2d0" -> "NetworkAttachmentDefinition/demo/ovs-vlan200" [label="created-from (Observed)", style=solid, tooltip="network-status entry names the NAD"];
  "NetworkAttachmentDefinition/demo/ovs-vlan200" -> "OVSBridge/br-data" [label="uses-host-device (Declared)", style=dashed, tooltip="NAD config names \"br-data\"; present in the host snapshot"];
  "PodInterface/demo/virt-launcher-db-03-p8w4k/pod3e9a1c7b2d0" -> "OVSPort/veth3e9a1c7b" [label="plugged-into (Observed)", style=solid, tooltip="external_ids contPodUid+contIface"];
  "OVSPort/veth3e9a1c7b" -> "OVSBridge/br-data" [label="port-of (Observed)", style=solid, tooltip="OVSDB Bridge.ports"];
  "OVSBridge/br-data" -> "HostInterface/bond1" [label="uplink (Observed)", style=solid, tooltip="host snapshot port membership"];
  "HostInterface/bond1" -> "Bond/bond1" [label="is-bond (Observed)", style=solid, tooltip="host snapshot"];
  "Bond/bond1" -> "BondMember/bond1/ens1f0" [label="member (Observed)", style=solid, tooltip="host snapshot bond membership"];
  "Bond/bond1" -> "BondMember/bond1/ens1f1" [label="member (Observed)", style=solid, tooltip="host snapshot bond membership"];
}
